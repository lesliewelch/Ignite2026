table Store

	column StoreKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: StoreKey

	column StoreName
		dataType: string
		sourceColumn: StoreName

	column Channel
		dataType: string
		sourceColumn: Channel

	column City
		dataType: string
		sourceColumn: City

	column Country
		dataType: string
		sourceColumn: Country

	column Region
		dataType: string
		sourceColumn: Region

	partition Store = m
		mode: import
		source =
			let
				Source = #table(
					type table [StoreKey = Int64.Type,
				StoreName = text,
				Channel = text,
				City = text,
				Country = text,
				Region = text],
					{
				{1, "Copenhagen Flagship", "Brand Store", "Copenhagen", "Denmark", "Europe"},
				{2, "New York Fifth Avenue", "Brand Store", "New York", "United States", "North America"},
				{3, "LEGO.com", "Online", "Billund", "Denmark", "Europe"},
				{4, "Brick House Retail", "Retail Partner", "Seattle", "United States", "North America"},
				{5, "Toy Galaxy", "Retail Partner", "Melbourne", "Australia", "Asia Pacific"},
				{6, "Tokyo Brand Store", "Brand Store", "Tokyo", "Japan", "Asia Pacific"}
					}
				)
			in
					Source
