table Theme

	column ThemeKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: ThemeKey

	column Theme
		dataType: string
		sourceColumn: Theme

	column ThemeGroup
		dataType: string
		sourceColumn: ThemeGroup

	partition Theme = m
		mode: import
		source =
			let
				Source = #table(
					type table [ThemeKey = Int64.Type,
				Theme = text,
				ThemeGroup = text],
					{
				{1, "Star Wars", "Licensed"},
				{2, "Harry Potter", "Licensed"},
				{3, "Technic", "In-house"},
				{4, "City", "In-house"},
				{5, "Ideas", "In-house"},
				{6, "Friends", "In-house"}
					}
				)
			in
					Source
