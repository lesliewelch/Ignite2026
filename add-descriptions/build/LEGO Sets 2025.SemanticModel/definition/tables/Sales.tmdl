table Sales
	lineageTag: e850d373-38e8-4617-8759-a16f598f1047

	measure Revenue = SUMX(Sales, Sales[Quantity] * Sales[UnitPrice] * (1 - Sales[DiscountPct]))
		formatString: $#,##0.00
		lineageTag: c40ceb37-bc8b-4bd0-8f7c-3b11e4c3a2c3

	measure 'Units Sold' = SUM(Sales[Quantity])
		formatString: #,##0
		lineageTag: b6d71208-5783-4819-8346-661fdae06c66

	measure Orders = COUNTROWS(Sales)
		formatString: #,##0
		lineageTag: a586d031-1ca9-4417-b8fb-29c0170daebd

	measure 'Avg Selling Price' = DIVIDE([Revenue], [Units Sold])
		formatString: $#,##0.00
		lineageTag: 84f26085-f699-4807-afaa-01b14024264d

	measure 'Discount Amount' = SUMX(Sales, Sales[Quantity] * Sales[UnitPrice] * Sales[DiscountPct])
		formatString: $#,##0.00
		lineageTag: 51c77426-e8fb-4774-9d5a-b9ae0eae1198

