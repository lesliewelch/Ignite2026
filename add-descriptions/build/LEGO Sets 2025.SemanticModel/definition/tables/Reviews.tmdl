		formatString: Long Date
		lineageTag: 9f0d79f8-0831-4e2c-a690-598f6bd5c7b8
		summarizeBy: none
		sourceColumn: ReviewDate

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column SetKey
		dataType: int64
		isHidden
		lineageTag: 8b5c3b8e-cc1c-4941-9517-f8e8855dd6fd
		summarizeBy: none
		sourceColumn: SetKey

	column Rating
		dataType: int64
		isHidden
		lineageTag: c78d6894-0945-4553-a8dd-e471cfd0a811
		summarizeBy: average
		sourceColumn: Rating

	column BuildHours
		dataType: double
		isHidden
		lineageTag: 1e6c1115-1a8e-42bc-95b7-3c954d0d22f5
		summarizeBy: sum
		sourceColumn: BuildHours

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column AgeGroup
		dataType: string
		lineageTag: fd3eba31-80da-48df-8b24-4a9e120abf68
		sourceColumn: AgeGroup

