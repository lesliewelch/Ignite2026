table Reviews
	lineageTag: c34c53d8-f36b-40b4-b5e8-b491e122338e

	measure 'Avg Rating' = AVERAGE(Reviews[Rating])
		formatString: 0.0
		lineageTag: a7bb27be-bd16-4573-ae9d-31ed9036928f

	measure 'Review Count' = COUNTROWS(Reviews)
		formatString: #,##0
		lineageTag: f852d275-09a9-4dfc-bbac-a95754ad01f8

	measure 'Avg Build Hours' = AVERAGE(Reviews[BuildHours])
		formatString: 0.0
		lineageTag: 94f6320b-1feb-45d2-8828-c9e26d56fff4

	column ReviewKey
		dataType: int64
		isHidden
		lineageTag: 4a28d323-77d7-4078-96c0-5a47ca2dfff0
		summarizeBy: none
		sourceColumn: ReviewKey

	column ReviewDate
