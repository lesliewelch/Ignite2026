    "dataYear": 2025,
    "tables": [
      {
        "name": "Sales",
        "description": "One row per fictional 2025 set order, including its store, promotion, quantity, and realized discount.",
        "columns": [
          { "name": "SalesKey", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Unique identifier for a sales order row." },
          { "name": "OrderDate", "dataType": "dateTime", "mType": "date", "valueType": "date", "description": "Date the order was placed." },
          { "name": "SetKey", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Set purchased in the order." },
          { "name": "StoreKey", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Store or channel fulfilling the order." },
          { "name": "PromotionKey", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Promotion applied to the order; zero means no promotion." },
          { "name": "Quantity", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "sum", "description": "Number of sets in this order." },
          { "name": "UnitPrice", "dataType": "decimal", "mType": "number", "valueType": "number", "hidden": true, "summarizeBy": "sum", "description": "Retail price per set before discount." },
          { "name": "DiscountPct", "dataType": "decimal", "mType": "number", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Effective discount rate applied to this order." }
        ],
        "measures": [
          { "name": "Revenue", "expression": "SUMX(Sales, Sales[Quantity] * Sales[UnitPrice] * (1 - Sales[DiscountPct]))", "format": "$#,##0.00", "description": "Net sales after discounts for the current filter context." },
          { "name": "Units Sold", "expression": "SUM(Sales[Quantity])", "format": "#,##0", "description": "Total sets sold in the current filter context." },
          { "name": "Orders", "expression": "COUNTROWS(Sales)", "format": "#,##0", "description": "Number of fictional order rows in the current filter context." },
          { "name": "Avg Selling Price", "expression": "DIVIDE([Revenue], [Units Sold])", "format": "$#,##0.00", "description": "Net revenue per set sold." },
          { "name": "Discount Amount", "expression": "SUMX(Sales, Sales[Quantity] * Sales[UnitPrice] * Sales[DiscountPct])", "format": "$#,##0.00", "description": "Gross value discounted from set sales." }
        ]
      },
      {
        "name": "Reviews",
        "description": "One row per fictional builder review, including rating, estimated build time, and reviewer age group.",
        "columns": [
          { "name": "ReviewKey", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Unique identifier for a review." },
          { "name": "ReviewDate", "dataType": "dateTime", "mType": "date", "valueType": "date", "description": "Date the review was submitted." },
          { "name": "SetKey", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Set being reviewed." },
          { "name": "Rating", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "average", "description": "Builder rating from one to five." },
          { "name": "BuildHours", "dataType": "decimal", "mType": "number", "valueType": "number", "hidden": true, "summarizeBy": "average", "description": "Estimated hours to complete the build." },
          { "name": "AgeGroup", "dataType": "string", "mType": "text", "valueType": "string", "description": "Age group of the reviewer." }
        ],
        "measures": [
          { "name": "Avg Rating", "expression": "AVERAGE(Reviews[Rating])", "format": "0.0", "description": "Average builder rating on a five-point scale." },
          { "name": "Review Count", "expression": "COUNTROWS(Reviews)", "format": "#,##0", "description": "Number of reviews in the current filter context." },
          { "name": "Avg Build Hours", "expression": "AVERAGE(Reviews[BuildHours])", "format": "0.0", "description": "Average estimated build duration in hours." }
        ]
      },
      {
        "name": "Inventory",
        "description": "Quarter-end inventory snapshot for every modeled set and store; 432 rows at a set-store-quarter grain.",
        "columns": [
          { "name": "InventoryKey", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Unique identifier for an inventory snapshot row." },
          { "name": "SnapshotDate", "dataType": "dateTime", "mType": "date", "valueType": "date", "description": "Quarter-end date represented by the snapshot." },
          { "name": "SetKey", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Set represented by the snapshot." },
          { "name": "StoreKey", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Store represented by the snapshot." },
          { "name": "OnHandQty", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "sum", "description": "Units available at the snapshot date." },
          { "name": "ReorderPoint", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Stock level below which a set is considered low." },
          { "name": "UnitCost", "dataType": "decimal", "mType": "number", "valueType": "number", "hidden": true, "summarizeBy": "sum", "description": "Fictional unit cost used to estimate inventory value." }
        ],
        "measures": [
          { "name": "Units On Hand", "expression": "CALCULATE(SUM(Inventory[OnHandQty]), LASTDATE('Date'[Date]))", "format": "#,##0", "description": "On-hand units at the latest date in the selected date context." },
          { "name": "Low Stock Sets", "expression": "COUNTROWS(FILTER(VALUES('Set'[SetKey]), [Units On Hand] < CALCULATE(MAX(Inventory[ReorderPoint]))))", "format": "#,##0", "description": "Distinct sets below their reorder point at the latest selected snapshot." },
          { "name": "Inventory Value", "expression": "CALCULATE(SUMX(Inventory, Inventory[OnHandQty] * Inventory[UnitCost]), LASTDATE('Date'[Date]))", "format": "$#,##0.00", "description": "Estimated cost value of on-hand units at the latest selected snapshot." }
        ]
      },
      {
        "name": "Set",
        "description": "Product catalog at one row per LEGO set, including theme, designer, piece count, and retail price.",
        "columns": [
          { "name": "SetKey", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Unique identifier for a set." },
          { "name": "SetNumber", "dataType": "string", "mType": "text", "valueType": "string", "description": "Public-facing set number." },
          { "name": "SetName", "dataType": "string", "mType": "text", "valueType": "string", "description": "Fictional set name." },
          { "name": "ThemeKey", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Theme assigned to the set." },
          { "name": "DesignerKey", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Primary designer assigned to the set." },
          { "name": "Pieces", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "summarizeBy": "sum", "description": "Number of pieces in the set." },
          { "name": "Minifigs", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "summarizeBy": "sum", "description": "Number of minifigures in the set." },
          { "name": "RetailPrice", "dataType": "decimal", "mType": "number", "valueType": "number", "summarizeBy": "sum", "description": "Fictional retail price in US dollars." },
          { "name": "ReleaseYear", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "summarizeBy": "none", "description": "Year the fictional set was released." }
        ],
        "measures": [
          { "name": "Total Pieces", "expression": "SUM('Set'[Pieces])", "format": "#,##0", "description": "Total pieces across the sets in the current filter context." },
          { "name": "Price per Piece", "expression": "DIVIDE(SUM('Set'[RetailPrice]), SUM('Set'[Pieces]))", "format": "$0.00", "description": "Weighted retail price per piece for the selected sets." }
        ]
      },
      {
        "name": "Theme",
        "description": "Six LEGO themes grouped as licensed or in-house properties.",
        "columns": [
          { "name": "ThemeKey", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Unique identifier for a theme." },
