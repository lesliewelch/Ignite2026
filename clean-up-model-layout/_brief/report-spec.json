          { "name": "MonthNo", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Numeric month sort order." },
          { "name": "Month", "dataType": "string", "mType": "text", "valueType": "string", "sortByColumn": "MonthNo", "description": "Calendar month name, sorted by month number." }
        ]
