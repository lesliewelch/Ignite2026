          { "name": "PromotionKey", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Unique identifier for a promotion; zero means no promotion." },
          { "name": "PromotionName", "dataType": "string", "mType": "text", "valueType": "string", "description": "Promotion campaign name." },
          { "name": "PromotionType", "dataType": "string", "mType": "text", "valueType": "string", "description": "Promotion category." },
