          { "name": "DesignerKey", "dataType": "int64", "mType": "Int64.Type", "valueType": "number", "hidden": true, "summarizeBy": "none", "description": "Unique identifier for a designer." },
          { "name": "DesignerName", "dataType": "string", "mType": "text", "valueType": "string", "description": "Fictional designer name." },
          { "name": "Studio", "dataType": "string", "mType": "text", "valueType": "string", "description": "Fictional design studio." },
