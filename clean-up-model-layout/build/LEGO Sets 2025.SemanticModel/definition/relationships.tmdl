relationship 'Sales Order Date'
	fromColumn: Sales.OrderDate
	toColumn: Date.Date
	crossFilteringBehavior: oneDirection

relationship 'Sales Set'
	fromColumn: Sales.SetKey
	toColumn: 'Set'.SetKey
	crossFilteringBehavior: oneDirection

relationship 'Sales Store'
	fromColumn: Sales.StoreKey
	toColumn: Store.StoreKey
	crossFilteringBehavior: oneDirection

relationship 'Sales Promotion'
	fromColumn: Sales.PromotionKey
	toColumn: Promotion.PromotionKey
	crossFilteringBehavior: oneDirection

relationship 'Reviews Review Date'
	fromColumn: Reviews.ReviewDate
	toColumn: Date.Date
	crossFilteringBehavior: oneDirection

relationship 'Reviews Set'
	fromColumn: Reviews.SetKey
	toColumn: 'Set'.SetKey
	crossFilteringBehavior: oneDirection

relationship 'Inventory Snapshot Date'
	fromColumn: Inventory.SnapshotDate
	toColumn: Date.Date
	crossFilteringBehavior: oneDirection

relationship 'Inventory Set'
	fromColumn: Inventory.SetKey
	toColumn: 'Set'.SetKey
	crossFilteringBehavior: oneDirection

relationship 'Inventory Store'
	fromColumn: Inventory.StoreKey
	toColumn: Store.StoreKey
	crossFilteringBehavior: oneDirection

relationship 'Set Theme'
	fromColumn: 'Set'.ThemeKey
	toColumn: Theme.ThemeKey
	crossFilteringBehavior: oneDirection

relationship 'Set Designer'
	fromColumn: 'Set'.DesignerKey
	toColumn: Designer.DesignerKey
	crossFilteringBehavior: oneDirection
