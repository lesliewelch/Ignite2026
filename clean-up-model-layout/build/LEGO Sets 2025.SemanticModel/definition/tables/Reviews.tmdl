/// One row per fictional builder review, including rating, estimated build time, and reviewer age group.
table Reviews

	/// Average builder rating on a five-point scale.
	measure 'Avg Rating' = AVERAGE(Reviews[Rating])
		formatString: 0.0

	/// Number of reviews in the current filter context.
	measure 'Review Count' = COUNTROWS(Reviews)
		formatString: #,##0

	/// Average estimated build duration in hours.
	measure 'Avg Build Hours' = AVERAGE(Reviews[BuildHours])
		formatString: 0.0

	/// Unique identifier for a review.
	column ReviewKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: ReviewKey

	/// Date the review was submitted.
	column ReviewDate
		dataType: dateTime
		sourceColumn: ReviewDate

	/// Set being reviewed.
	column SetKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: SetKey

	/// Builder rating from one to five.
	column Rating
		dataType: int64
		isHidden
		summarizeBy: average
		sourceColumn: Rating

	/// Estimated hours to complete the build.
	column BuildHours
		dataType: decimal
		isHidden
		summarizeBy: average
		sourceColumn: BuildHours

	/// Age group of the reviewer.
	column AgeGroup
		dataType: string
		sourceColumn: AgeGroup

	partition Reviews = m
		mode: import
		source =
			let
				Source = #table(
					type table [ReviewKey = Int64.Type,
				ReviewDate = date,
				SetKey = Int64.Type,
				Rating = Int64.Type,
				BuildHours = number,
				AgeGroup = text],
					{
				{1, #date(2025, 1, 1), 1, 4, 5, "Adult"},
				{2, #date(2025, 3, 10), 2, 3, 7.5, "Teen"},
				{3, #date(2025, 5, 17), 3, 5, 11.3, "Child"},
				{4, #date(2025, 7, 24), 4, 4, 7, "Adult"},
				{5, #date(2025, 9, 29), 5, 3, 13.7, "Teen"},
				{6, #date(2025, 12, 6), 6, 5, 5.5, "Child"},
				{7, #date(2025, 2, 7), 7, 4, 8.2, "Adult"},
				{8, #date(2025, 4, 16), 8, 3, 9.8, "Teen"},
				{9, #date(2025, 6, 23), 9, 5, 16.1, "Child"},
				{10, #date(2025, 8, 30), 10, 4, 5.6, "Adult"},
				{11, #date(2025, 11, 5), 11, 3, 16.8, "Teen"},
				{12, #date(2025, 1, 7), 12, 5, 4, "Child"},
				{13, #date(2025, 3, 16), 13, 4, 12.4, "Adult"},
				{14, #date(2025, 5, 23), 14, 3, 7.1, "Teen"},
				{15, #date(2025, 7, 30), 15, 5, 9.2, "Child"},
				{16, #date(2025, 10, 6), 16, 4, 10, "Adult"},
				{17, #date(2025, 12, 12), 17, 3, 9.8, "Teen"},
				{18, #date(2025, 2, 13), 18, 5, 5.6, "Child"},
				{19, #date(2025, 4, 22), 1, 4, 6, "Adult"},
				{20, #date(2025, 6, 29), 2, 3, 8.5, "Teen"},
				{21, #date(2025, 9, 5), 3, 5, 10.6, "Child"},
				{22, #date(2025, 11, 12), 4, 4, 6.3, "Adult"},
				{23, #date(2025, 1, 13), 5, 3, 13, "Teen"},
				{24, #date(2025, 3, 22), 6, 5, 6.5, "Child"},
				{25, #date(2025, 5, 29), 7, 4, 9.2, "Adult"},
				{26, #date(2025, 8, 5), 8, 3, 9.1, "Teen"},
				{27, #date(2025, 10, 12), 9, 5, 15.4, "Child"},
				{28, #date(2025, 12, 19), 10, 4, 4.9, "Adult"},
				{29, #date(2025, 2, 19), 11, 3, 17.9, "Teen"},
				{30, #date(2025, 4, 28), 12, 5, 5, "Child"},
				{31, #date(2025, 7, 5), 13, 4, 11.7, "Adult"},
				{32, #date(2025, 9, 11), 14, 3, 6.4, "Teen"},
				{33, #date(2025, 11, 18), 15, 5, 8.5, "Child"},
				{34, #date(2025, 1, 20), 16, 4, 11.1, "Adult"},
				{35, #date(2025, 3, 28), 17, 3, 10.8, "Teen"},
				{36, #date(2025, 6, 4), 18, 5, 4.9, "Child"}
					}
				)
			in
					Source
