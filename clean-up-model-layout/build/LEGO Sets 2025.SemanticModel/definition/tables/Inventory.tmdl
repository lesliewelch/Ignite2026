/// Quarter-end inventory snapshot for every modeled set and store; 432 rows at a set-store-quarter grain.
table Inventory

	/// On-hand units at the latest date in the selected date context.
	measure 'Units On Hand' = CALCULATE(SUM(Inventory[OnHandQty]), LASTDATE('Date'[Date]))
		formatString: #,##0

	/// Distinct sets below their reorder point at the latest selected snapshot.
	measure 'Low Stock Sets' = COUNTROWS(FILTER(VALUES('Set'[SetKey]), [Units On Hand] < CALCULATE(MAX(Inventory[ReorderPoint]))))
		formatString: #,##0

	/// Estimated cost value of on-hand units at the latest selected snapshot.
	measure 'Inventory Value' = CALCULATE(SUMX(Inventory, Inventory[OnHandQty] * Inventory[UnitCost]), LASTDATE('Date'[Date]))
		formatString: $#,##0.00

	/// Unique identifier for an inventory snapshot row.
	column InventoryKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: InventoryKey

	/// Quarter-end date represented by the snapshot.
	column SnapshotDate
		dataType: dateTime
		sourceColumn: SnapshotDate

	/// Set represented by the snapshot.
	column SetKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: SetKey

	/// Store represented by the snapshot.
	column StoreKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: StoreKey

	/// Units available at the snapshot date.
	column OnHandQty
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: OnHandQty

	/// Stock level below which a set is considered low.
	column ReorderPoint
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: ReorderPoint

	/// Fictional unit cost used to estimate inventory value.
	column UnitCost
		dataType: decimal
		isHidden
		summarizeBy: sum
		sourceColumn: UnitCost

	partition Inventory = m
		mode: import
		source =
			let
				Source = #table(
					type table [InventoryKey = Int64.Type,
				SnapshotDate = date,
				SetKey = Int64.Type,
				StoreKey = Int64.Type,
				OnHandQty = Int64.Type,
				ReorderPoint = Int64.Type,
				UnitCost = number],
