/// One row per fictional 2025 set order, including its store, promotion, quantity, and realized discount.
table Sales
	lineageTag: 9cc6e18c-ebcf-41e7-89ea-caff851bf409

	/// Net sales after discounts for the current filter context.
	measure Revenue = SUMX(Sales, Sales[Quantity] * Sales[UnitPrice] * (1 - Sales[DiscountPct]))
		formatString: $#,##0.00
		lineageTag: 5864b664-cd31-4733-bf0b-2877f23a73ea

	/// Total sets sold in the current filter context.
	measure 'Units Sold' = SUM(Sales[Quantity])
		formatString: #,##0
		lineageTag: 18ebdf18-1176-4e38-80c4-d378d01e02e7

	/// Number of fictional order rows in the current filter context.
	measure Orders = COUNTROWS(Sales)
		formatString: #,##0
		lineageTag: a9ad3fd2-1bbe-4e3a-8f9e-2f22cb448b56

	/// Net revenue per set sold.
	measure 'Avg Selling Price' = DIVIDE([Revenue], [Units Sold])
		formatString: $#,##0.00
		lineageTag: ec4d1798-11a1-489b-83f2-e8fcd39a69e1

	/// Gross value discounted from set sales.
	measure 'Discount Amount' = SUMX(Sales, Sales[Quantity] * Sales[UnitPrice] * Sales[DiscountPct])
		formatString: $#,##0.00
		lineageTag: 68a87cf9-fad5-4d08-89b3-782020966225

	/// Unique identifier for a sales order row.
	column SalesKey
		dataType: int64
		isHidden
		lineageTag: 21781479-c0f2-4f4b-856c-b4678fdd2459
		summarizeBy: none
		sourceColumn: SalesKey

	/// Date the order was placed.
	column OrderDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: ba9fd532-d0f8-49bc-a90a-550eeecfd22a
		summarizeBy: none
		sourceColumn: OrderDate

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	/// Set purchased in the order.
	column SetKey
		dataType: int64
		isHidden
		lineageTag: a05151ba-9ef0-478a-9181-0d5f3fd8966d
		summarizeBy: none
		sourceColumn: SetKey

	/// Store or channel fulfilling the order.
	column StoreKey
		dataType: int64
		isHidden
		lineageTag: e05b1559-120a-40f6-883a-ffe751e4f122
		summarizeBy: none
		sourceColumn: StoreKey

	/// Promotion applied to the order; zero means no promotion.
	column PromotionKey
		dataType: int64
		isHidden
		lineageTag: 959db9b5-60ad-4359-a3fa-c0078f82bbd6
		summarizeBy: none
		sourceColumn: PromotionKey

	/// Number of sets in this order.
	column Quantity
		dataType: int64
		isHidden
		lineageTag: cf588c90-f100-47dd-b71a-93fe83f54904
		summarizeBy: sum
		sourceColumn: Quantity

	/// Retail price per set before discount.
	column UnitPrice
		dataType: double
		isHidden
		lineageTag: b3771721-410f-44f7-82b2-436aa234d37a
		summarizeBy: sum
		sourceColumn: UnitPrice

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Effective discount rate applied to this order.
	column DiscountPct
		dataType: double
		isHidden
		lineageTag: f72ecea0-e99f-4539-8954-79fa28d19c2b
		summarizeBy: sum
		sourceColumn: DiscountPct

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

